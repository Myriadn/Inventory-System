							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Login Successful\", function () {\r",
									"    pm.response.to.have.status(200);\r",
									"});\r",
									"\r",
									"var jsonData = pm.response.json();\r",
									"\r",
									"if (jsonData.token) {\r",
									"    // Simpan ke Environment Variable 'token_superAdmin'\r",
									"    pm.environment.set(\"token_superAdmin\", jsonData.token);\r",
									"    console.log(\"Token Super Admin saved!\");\r",
									"} else if (jsonData.data && jsonData.data.token) {\r",
									"    pm.environment.set(\"token_superAdmin\", jsonData.data.token);\r",
									"    console.log(\"Token Super Admin saved!\");\r",
									"} else {\r",
									"    console.log(\"Token not found in response\");\r",
									"}"
